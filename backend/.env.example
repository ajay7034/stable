CI_ENVIRONMENT = production
app.baseURL = 'https://example.com/'
database.default.DBDriver = SQLite3
database.default.database = /app/backend/writable/stable.sqlite
database.default.foreignKeys = true
database.default.busyTimeout = 5000
# Optional outbound SMTP. Configure securely; never commit actual credentials.
STABLE_SMTP_HOST = ''
STABLE_SMTP_PORT = 587
STABLE_SMTP_CRYPTO = tls
STABLE_SMTP_USER = ''
STABLE_SMTP_PASSWORD = ''
STABLE_SMTP_FROM = ''
STABLE_NOTIFICATION_EMAIL = ''

# Disabled until the business chooses a retention policy. Applies to closed records.
STABLE_RETENTION_DAYS = 0
# Optional applicant acknowledgement messages, requires configured SMTP.
STABLE_APPLICANT_CONFIRMATIONS = false

# Cookie URL prefix, e.g. /stable on the temporary server.
STABLE_BASE_PATH = ''
